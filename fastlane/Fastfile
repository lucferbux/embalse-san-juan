# The App Store listing, as files. Binaries go through `scripts/release.sh`.
# Nothing here submits for review: the version stays in Prepare for Submission.
#
# App Review contact details need phone_number.txt and email_address.txt in
# metadata/ios/review_information. They're gitignored: without them, deliver dies creating the review
# detail (fastlane #20538). App Store Connect keeps the values once pushed.

opt_out_usage
skip_docs

default_platform(:ios)

# The App Store Connect API key. The .p8 never belongs in this repo.
def asc_key
  key_id    = ENV["ASC_KEY_ID"] || "KMSBU6865L"
  issuer_id = ENV["ASC_ISSUER_ID"] || "69a6de88-17cf-47e3-e053-5b8c7c11a4d1"
  key_path  = File.expand_path(ENV["ASC_KEY_PATH"] || "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  UI.user_error!("No API key at #{key_path}") unless File.exist?(key_path)

  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path, duration: 1200, in_house: false)
end

def deliver_options(skip_screenshots:)
  {
    api_key: asc_key,
    platform: "ios",
    app_version: "1.0",
    metadata_path: "./fastlane/metadata/ios",
    screenshots_path: "./fastlane/screenshots",
    skip_binary_upload: true,
    skip_screenshots: skip_screenshots,
    overwrite_screenshots: true,
    submit_for_review: false,
    automatic_release: false,
    force: true,
    precheck_include_in_app_purchases: false,
    run_precheck_before_submit: false
  }
end

desc "Push the text and screenshots as a draft"
lane :metadata do
  upload_to_app_store(**deliver_options(skip_screenshots: false))
end

desc "Push the text only"
lane :metadata_text do
  upload_to_app_store(**deliver_options(skip_screenshots: true))
end

desc "Apple's own checks on the listing"
lane :precheck_all do
  check_app_store_metadata(api_key: asc_key, platform: "ios", default_rule_level: :warn, include_in_app_purchases: false)
end

desc "Show the builds App Store Connect has"
lane :builds do
  key_id = ENV["ASC_KEY_ID"] || "KMSBU6865L"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: key_id,
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de88-17cf-47e3-e053-5b8c7c11a4d1",
    filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
  app = Spaceship::ConnectAPI::App.find("com.lucferbux.embalsesanjuan")
  app.get_builds.each { |build| UI.message("Build #{build.version}: #{build.processing_state}") }
end

desc "Push screenshots only, skipping deliver's metadata step"
lane :screenshots_upload do
  upload_to_app_store(
    api_key: asc_key,
    platform: "ios",
    app_version: "1.0",
    metadata_path: "./fastlane/metadata/ios",
    screenshots_path: "./fastlane/screenshots",
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: false,
    overwrite_screenshots: true,
    submit_for_review: false,
    force: true,
    run_precheck_before_submit: false
  )
end

# Deliver sets these last, after the review detail step that needs a phone number, so while there
# isn't one this sets the app-level fields directly.
desc "Set the name, subtitle, privacy URL and categories"
lane :app_info do
  key_id = ENV["ASC_KEY_ID"] || "KMSBU6865L"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: key_id,
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de88-17cf-47e3-e053-5b8c7c11a4d1",
    filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
  read = ->(name) { File.read("metadata/ios/es-ES/#{name}.txt").strip }
  app = Spaceship::ConnectAPI::App.find("com.lucferbux.embalsesanjuan")
  info = app.fetch_edit_app_info
  info.update_categories(category_id_map: { primary_category_id: "WEATHER", secondary_category_id: "UTILITIES" })
  localization = info.get_app_info_localizations.find { |l| l.locale == "es-ES" }
  localization.update(attributes: { name: read.call("name"), subtitle: read.call("subtitle"), privacyPolicyUrl: read.call("privacy_url") })
  UI.success("App info updated")
end

TIPS = [
  { id: "com.lucferbux.embalsesanjuan.tip.small", name: "Propina pequeña", description: "Un café para el mantenimiento", price: "0.99" },
  { id: "com.lucferbux.embalsesanjuan.tip.medium", name: "Propina mediana", description: "Un mes de mantenimiento", price: "2.99" },
  { id: "com.lucferbux.embalsesanjuan.tip.large", name: "Propina grande", description: "Varios meses de mantenimiento", price: "4.99" }
].freeze

# Creates the consumable tips, skipping any that exist. Prices are based on Spain, and Apple sets the rest.
desc "Create the tip in-app purchases"
lane :tips do
  require "net/http"
  require "digest"
  key_id = ENV["ASC_KEY_ID"] || "KMSBU6865L"
  token = Spaceship::ConnectAPI::Token.create(
    key_id: key_id,
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de88-17cf-47e3-e053-5b8c7c11a4d1",
    filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
  api = lambda do |method, path, body = nil|
    uri = URI("https://api.appstoreconnect.apple.com#{path}")
    request = Net::HTTP.const_get(method).new(uri)
    request["Authorization"] = "Bearer #{token.text}"
    request["Content-Type"] = "application/json"
    request.body = JSON.generate(body) if body
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    UI.user_error!("#{method} #{path}: #{response.code} #{response.body}") unless response.code.to_i < 300
    response.body.to_s.empty? ? {} : JSON.parse(response.body)
  end
  app_id = "6828988892"
  screenshot = "screenshots_review/tips.png"
  existing = api.call(:Get, "/v1/apps/#{app_id}/inAppPurchasesV2?limit=50")["data"].map { |i| i["attributes"]["productId"] }
  territories = api.call(:Get, "/v1/territories?limit=200")["data"].map { |t| { type: "territories", id: t["id"] } }

  TIPS.each do |tip|
    if existing.include?(tip[:id])
      UI.message("#{tip[:id]} already exists")
      next
    end
    purchase_id = api.call(:Post, "/v2/inAppPurchases", { data: { type: "inAppPurchases",
      attributes: { name: tip[:name], productId: tip[:id], inAppPurchaseType: "CONSUMABLE",
                    reviewNote: "Voluntary tip to the developer. It unlocks nothing." },
      relationships: { app: { data: { type: "apps", id: app_id } } } } })["data"]["id"]
    purchase = { type: "inAppPurchases", id: purchase_id }

    api.call(:Post, "/v1/inAppPurchaseLocalizations", { data: { type: "inAppPurchaseLocalizations",
      attributes: { locale: "es-ES", name: tip[:name], description: tip[:description] },
      relationships: { inAppPurchaseV2: { data: purchase } } } })

    api.call(:Post, "/v1/inAppPurchaseAvailabilities", { data: { type: "inAppPurchaseAvailabilities",
      attributes: { availableInNewTerritories: true },
      relationships: { inAppPurchase: { data: purchase }, availableTerritories: { data: territories } } } })

    points = api.call(:Get, "/v2/inAppPurchases/#{purchase_id}/pricePoints?filter%5Bterritory%5D=ESP&limit=200")["data"]
    point = points.find { |p| p["attributes"]["customerPrice"] == tip[:price] } || UI.user_error!("No price point #{tip[:price]}")
    api.call(:Post, "/v1/inAppPurchasePriceSchedules", {
      data: { type: "inAppPurchasePriceSchedules", relationships: {
        inAppPurchase: { data: purchase },
        baseTerritory: { data: { type: "territories", id: "ESP" } },
        manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${price}" }] } } },
      included: [{ type: "inAppPurchasePrices", id: "${price}", attributes: { startDate: nil },
                   relationships: { inAppPurchaseV2: { data: purchase },
                                    inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: point["id"] } } } }] })

    bytes = File.binread(screenshot)
    reservation = api.call(:Post, "/v1/inAppPurchaseAppStoreReviewScreenshots", { data: { type: "inAppPurchaseAppStoreReviewScreenshots",
      attributes: { fileName: "tips.png", fileSize: bytes.bytesize },
      relationships: { inAppPurchaseV2: { data: purchase } } } })["data"]
    reservation["attributes"]["uploadOperations"].each do |operation|
      uri = URI(operation["url"])
      request = Net::HTTP.const_get(operation["method"].capitalize).new(uri)
      operation["requestHeaders"].each { |header| request[header["name"]] = header["value"] }
      request.body = bytes.byteslice(operation["offset"], operation["length"])
      response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
      UI.user_error!("Screenshot upload: #{response.code}") unless response.code.to_i < 300
    end
    api.call(:Patch, "/v1/inAppPurchaseAppStoreReviewScreenshots/#{reservation["id"]}", { data: {
      type: "inAppPurchaseAppStoreReviewScreenshots", id: reservation["id"],
      attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
    UI.success("Created #{tip[:id]} at #{tip[:price]} EUR")
  end
end
