{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check:*)",
      "Bash(make check-backend)",
      "Bash(make check-ios)",
      "Bash(make generate)",
      "Bash(make live-check)",
      "Bash(make widgets)",
      "Bash(make fixture)",
      "Bash(make scan-secrets)"
    ],
    "deny": [
      "Read(**/*service-account*.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fast-check.sh" }]
      }
    ]
  }
}
